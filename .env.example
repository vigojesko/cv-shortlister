# PostgreSQL online: pooled URL for requests, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=3"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
# Generate these three values with npm run secrets. Never commit actual values.
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""
WORKER_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Callback: https://YOUR-SITE.netlify.app/api/auth/callback/google
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Comma-separated invited emails. Empty permits any authorized Google account.
ALLOWED_EMAILS=""
ENABLE_LOCAL_SCHEDULER="false"
# SMTP notifications are off by default. The global recipient is no longer used.
ENABLE_EMAIL_DIGEST="false"
