# Environment Variables for CV Shortlister

# App & Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cv-shortlister-secret-key-32-chars-long-at-least-safe"
ADMIN_EMAIL="admin@cvshortlister.local"
ADMIN_PASSWORD="AdminPassword123!"

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Security (AES-256-GCM encryption key, 32 hex bytes or 32 chars)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google Gemini AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Google OAuth & Gmail API (Scope: gmail.readonly)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
GMAIL_TEST_ACCOUNT="Georgevigo2005@gmail.com"

# Sync & Automation
SYNC_INTERVAL_MINUTES="15"

# SMTP Notifications (Opsional, kosongkan jika tidak digunakan)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@cvshortlister.local"
SMTP_NOTIFICATION_EMAIL=""
